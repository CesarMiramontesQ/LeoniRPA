# Configuración para arrancar la API FastAPI
# Copia este archivo a .env y ajusta los valores si es necesario
#
# API accesible en la red LAN: http://IP_DEL_SERVIDOR:API_PORT
# Uso con NSSM/servicio Windows: run.bat puede usarse como comando de inicio

API_HOST=0.0.0.0
API_PORT=8000
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/leoni_rpa

# Credenciales de SAP GUI. Copialas al .env real; ese archivo no se sube a git.
# bom.vbs las lee del entorno del proceso o del .env que esta junto al script.
SAP_USER=
SAP_PASSWORD=
# Nombre exacto del workspace o conexion en SAP Logon. No usar "LEONI AG SSO".
SAP_WORKSPACE=z LCS on-premise
# Opcional. Ejemplo: EN o ES. Vacio = se deja el idioma que ya traiga la pantalla de acceso.
SAP_LANGUAGE=